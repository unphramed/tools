#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Install this tool as a Composer development dependency before running it.\n");
    exit(1);
}

require $autoload;
exit(Unphramed\Tools\RoutesCommand::run($argv));
