{
    "name": "unphramed/tools",
    "description": "Development-only tools for explicit native Nginx method-to-PHP-file associations.",
    "type": "library",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-posix": "*",
        "composer-runtime-api": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Unphramed\\Tools\\": "src/"
        }
    },
    "bin": [
        "bin/unphramed-routes"
    ],
    "keywords": [
        "development",
        "tooling",
        "nginx",
        "routing",
        "unphramed"
    ]
}
